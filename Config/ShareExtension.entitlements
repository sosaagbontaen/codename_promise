<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The App Group is how the share sheet hands captures to the app: the extension writes
     into the group's Inbox folder, the app files from it. See CaptureInbox. -->
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.codenamepromise.journal</string>
	</array>
</dict>
</plist>

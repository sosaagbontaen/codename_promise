# Copy to .env and fill in. .env is gitignored — never commit real values.
# Load with:  set -a && source .env && set +a

# Shared secret the iOS app sends as `Authorization: Bearer <key>`.
# Leave unset for local development; the API is then open.
CP_API_KEY=

# Groq Cloud. https://console.groq.com/keys
GROQ_API_KEY=

# Notion public integration. https://www.notion.so/my-integrations
# The redirect URI must match exactly what you registered there.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/notion/oauth/callback
